# Production settings for docker compose. Copy to ".env" next to docker-compose.yml and fill in.
# Never commit the real .env.

# Public address of the app (must be HTTPS: phones only allow the camera on HTTPS).
APP_URL=https://absen.example.ac.id

# Port on 127.0.0.1 that the client web server proxies to.
APP_PORT=3000

# Database type: mysql (client's MySQL) or postgresql. Must match DATABASE_URL.
DB_PROVIDER=mysql

# Client's MySQL server. Use a database just for this app, and a user with all privileges on it:
#   CREATE DATABASE absen CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
#   CREATE USER 'absen'@'%' IDENTIFIED BY '…';
#   GRANT ALL PRIVILEGES ON absen.* TO 'absen'@'%';
# MySQL on the same machine as Docker:  mysql://absen:PASSWORD@host.docker.internal:3306/absen
# MySQL on another server:              mysql://absen:PASSWORD@db.example.ac.id:3306/absen
# Special characters in the password must be URL-encoded (e.g. @ → %40, # → %23).
DATABASE_URL=mysql://absen:CHANGE_ME@host.docker.internal:3306/absen

# Long random secret, at least 32 characters. Generate one with:  openssl rand -hex 32
# Changing it signs everyone out.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# How long a sign-in lasts, in hours.
SESSION_HOURS=12
