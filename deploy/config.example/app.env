# ISTA Presensi — server settings: /opt/ista-absen/config/app.env
# deploy.sh creates this file from the template on the first install; fill it in and run the install again.
# Secrets are NOT in this file: they are in separate files next to it (db_password, jwt_secret,
# hr_db_password, license.key). The app's own PostgreSQL needs no settings here.

# ---- Website --------------------------------------------------------------------------------
# Public address (must be HTTPS: phones only allow the camera on HTTPS).
CORS_ORIGIN=https://absen.example.ac.id
# How long a sign-in lasts, in hours.
SESSION_HOURS=12

# ---- Campus HR database (MariaDB, read-only) -------------------------------------------------------
# Staff (FID, NIK, Nama, DEPT_NAME, exit date, photo) are imported from hr_staff_info: at the first start,
# every night at 00:05 WIB, and with "Sinkronkan sekarang" on the dashboard. Everyone gets the role
# "Dosen"; the admin changes roles in Data Pegawai.
# Leave HR_DB_HOST empty to run without it: staff are then added by hand in Data Pegawai.
# HR database on this same machine: host.docker.internal (MariaDB must accept connections from the
# Docker network — see the guide). On another server: its host name or IP address.
HR_DB_HOST=
HR_DB_PORT=3306
# The database that holds hr_staff_info (find it: see the guide, section 5).
HR_DB_NAME=
# The read-only user created with deploy/mariadb/hr_read_access.sql. Its password goes in the file hr_db_password.
HR_DB_USER=ista_absen_reader
# Import profile photos from HR for people who haven't uploaded their own (true/false).
HR_PHOTO_IMPORT=true
# Run the sync automatically every night at 00:05 WIB.
SYNC_NIGHTLY=true
# Annual leave quota given to newly imported staff (can be changed per person afterwards).
SYNC_DEFAULT_QUOTA=12
# Safety stop: a run that would deactivate more than this % of synced staff is stopped
# (an admin can still force it from the dashboard).
SYNC_MAX_DEACTIVATE_PERCENT=20
# Advanced: a different SELECT for another HR table (columns: externalId, nip, name, unit, active,
# photoHash). Empty = the built-in query for hr_staff_info.
TEACHER_SOURCE_QUERY=
