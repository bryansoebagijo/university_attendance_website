// ISTA Presensi & SDM — database schema.
// Phase 2 uses User + UserPhoto. The rest is defined now so phases 3–5 only add API routes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  APPROVER
  ADMIN
}

enum Locale {
  id
  en
}

enum Theme {
  light
  dark
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  nip          String   @unique
  role         Role     @default(USER)
  unit         String   @default("")
  annualQuota  Int      @default(12)
  active       Boolean  @default(true)
  locale       Locale   @default(id)
  theme        Theme    @default(light)
  /// Set when an admin creates the account or resets the password; the user must choose a new one.
  mustChangePassword Boolean @default(false)
  /// Part of every session token. Bumping it (password change/reset) signs out all existing sessions.
  sessionVersion     Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  photo            UserPhoto?
  attendance       Attendance[]
  leaveRequests    LeaveRequest[] @relation("LeaveRequester")
  leaveDecisions   LeaveRequest[] @relation("LeaveApprover")
  schedules        WorkSchedule[]
  exemptions       AttendanceExemption[] @relation("ExemptedUser")
  exemptionsGiven  AttendanceExemption[] @relation("ExemptionCreator")
  attendanceEdits  Attendance[]          @relation("AttendanceEditor")
}

/// Which weekdays a person is expected on campus, from a date on. The newest row with
/// effectiveFrom <= a date applies to that date; with no row at all, Monday–Friday applies.
model WorkSchedule {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime @db.Date
  /// ISO weekdays as digits, 1 = Monday … 6 = Saturday, e.g. "24" = Tuesday + Thursday.
  days          String
  setById       String?
  createdAt     DateTime @default(now())

  @@unique([userId, effectiveFrom])
}

/// A scheduled day an admin excused ("Bebaskan"): not counted as absent and costs no leave.
model AttendanceExemption {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("ExemptedUser", fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  reason      String   @db.Text
  createdById String?
  createdBy   User?    @relation("ExemptionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([userId, date])
  @@index([date])
}

/// Audit trail of admin corrections (schedule changes, attendance added/edited/deleted, exemptions).
model AdminAction {
  id           String    @id @default(cuid())
  actorId      String
  targetUserId String
  /// The attendance day concerned, when there is one.
  date         DateTime? @db.Date
  /// e.g. ATTENDANCE_CREATE, ATTENDANCE_EDIT, ATTENDANCE_DELETE, EXEMPT, UNEXEMPT, SCHEDULE_SET, SCHEDULE_DELETE
  action       String
  reason       String?   @db.Text
  /// Before/after values, for reference.
  details      Json?
  createdAt    DateTime  @default(now())

  @@index([targetUserId, createdAt])
}

/// Profile picture bytes, kept apart from User so user lists never load images.
model UserPhoto {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  size      Int
  updatedAt DateTime @updatedAt
}

model Location {
  id        String   @id // slug, e.g. "gedung-a" — appears in QR tokens and kiosk URLs
  name      String
  building  String   @default("")
  active    Boolean  @default(true)
  /// HMAC key for this location's rotating QR tokens. Never sent to clients.
  qrSecret     String
  /// SHA-256 of the key a kiosk screen uses to fetch tokens; null = no kiosk paired.
  kioskKeyHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clockIns  Attendance[] @relation("ClockInLocation")
  clockOuts Attendance[] @relation("ClockOutLocation")
}

enum ScanMethod {
  CAMERA
  UPLOAD
  /// Entered or corrected by an admin.
  MANUAL
}

enum AttendanceStatus {
  CLOCKED_IN
  COMPLETE
  MISSING_CLOCK_OUT
  FIXED
  DEDUCTED
}

model Attendance {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Working day in Asia/Jakarta.
  date          DateTime         @db.Date
  clockIn       DateTime
  clockOut      DateTime?
  inLocationId  String
  inLocation    Location         @relation("ClockInLocation", fields: [inLocationId], references: [id])
  outLocationId String?
  outLocation   Location?        @relation("ClockOutLocation", fields: [outLocationId], references: [id])
  status        AttendanceStatus @default(CLOCKED_IN)
  /// How the QR was read: phone camera or an uploaded image (reported by the app; shown to admins for review).
  inMethod      ScanMethod       @default(CAMERA)
  outMethod     ScanMethod?
  fixReason     String?          @db.Text
  fixedAt       DateTime?
  deductedAt    DateTime?
  /// Set when an admin added or changed this record.
  editedById    String?
  editedBy      User?            @relation("AttendanceEditor", fields: [editedById], references: [id], onDelete: SetNull)
  editedAt      DateTime?
  editReason    String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([userId, date]) // one record per person per day
  @@index([date])
  @@index([status])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

/// ANNUAL uses the yearly quota. SICK needs approval too but never touches the quota.
enum LeaveType {
  ANNUAL
  SICK
}

model LeaveRequest {
  id           String      @id @default(cuid())
  type         LeaveType   @default(ANNUAL)
  userId       String
  user         User        @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  days         Int
  reason       String      @db.Text
  status       LeaveStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?       @relation("LeaveApprover", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  attachment   LeaveAttachment?

  @@index([userId, startDate])
  @@index([status])
}

/// Supporting document for a request (doctor's note for sick leave). Kept apart so lists never load file bytes.
model LeaveAttachment {
  requestId String       @id
  request   LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  fileName  String
  size      Int
  createdAt DateTime     @default(now())
}

/// Public holidays and campus days off. Not counted as working days for leave.
model Holiday {
  date      DateTime @id @db.Date
  name      String
  createdAt DateTime @default(now())
}
