NODE_ENV=development
PORT=4000
# PostgreSQL (default) or MySQL 8 — the backend picks the database from the URL:
DATABASE_URL=postgresql://absen:CHANGE_ME@localhost:5432/absen?schema=public
# DATABASE_URL=mysql://absen:CHANGE_ME@localhost:3306/absen
# At least 32 characters. Must match JWT_SECRET in frontend/.env.local.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_32+
SESSION_HOURS=12
CORS_ORIGIN=http://localhost:3000
